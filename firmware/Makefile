#######################################
# flash targets
#
# ⚠️ 0x08020000, no 0x08000000. Desde que existe la actualizacion por WiFi los
# primeros 128 kB son del bootloader (`make boot-flash`). Grabar la aplicacion
# en 0x08000000 pisa el bootloader: el equipo sigue arrancando —la app se
# ejecuta igual desde ahi— pero se queda sin OTA hasta volver a hacer
# `make boot-flash`, y ademas quedan dos copias del firmware en la flash.
#######################################
flash: all
	dfu-util -a 0 -s 0x08020000:leave -D $(BUILD_DIR)/$(TARGET).bin

flash-stlink: all
	st-flash --reset write $(BUILD_DIR)/$(TARGET).bin 0x08020000

# Primera instalacion o rescate: bootloader + aplicacion, en ese orden.
flash-todo: boot all
	st-flash write $(BOOT_BUILD)/$(BOOT_TARGET).bin 0x08000000
	st-flash --reset write $(BUILD_DIR)/$(TARGET).bin 0x08020000

# Flasheo por WiFi, sin cable. Requiere el bootloader ya instalado (make boot-flash).
# El equipo queda mudo durante la carga y se reinicia solo al terminar.
#
# Antes de subir le pregunta a la placa QUÉ placa es (/status → "board") y se
# niega si no coincide con BOARD: el binario de una DS12 en una DS11 maneja
# pines que en la DS11 están al aire. Un ESP32 viejo no manda "board", y eso
# sólo pasa en las DS11, así que la ausencia cuenta como DS11. Es la primera
# de tres barreras: el ESP32 (409) y el STM32 (OTA_End) miran además el bloque
# de identidad DENTRO del binario.
OTA_HOST ?= ds-1e1f30.local
OTA_PLACA = $(shell echo $(BOARD) | tr a-z A-Z)
ota: all
	@st=$$(curl -sS --max-time 10 "http://$(OTA_HOST)/status") || { \
	  echo "No contesta http://$(OTA_HOST)/status: no subo nada."; exit 1; }; \
	case "$$st" in *'"stm32":"ok"'*) ;; *) \
	  echo "El ESP32 contesta pero el STM32 no: no se puede saber qué placa es."; \
	  echo "No subo nada. Respuesta: $$st"; exit 1;; esac; \
	placa=$$(printf '%s' "$$st" | sed -n 's/.*"board":"\(DS[0-9][0-9]*\)".*/\1/p'); \
	[ -n "$$placa" ] || placa=DS11; \
	if [ "$$placa" != "$(OTA_PLACA)" ]; then \
	  echo "✗ $(OTA_HOST) es una $$placa y esto se compiló para $(OTA_PLACA)."; \
	  echo "  Usá: make ota BOARD=$$(echo $$placa | tr A-Z a-z) OTA_HOST=$(OTA_HOST)"; exit 1; fi; \
	echo "Placa en $(OTA_HOST): $$placa — coincide con BOARD=$(BOARD)."
	@echo "Subiendo $(BUILD_DIR)/$(TARGET).bin a http://$(OTA_HOST) ..."
	@curl -sS --max-time 240 -X POST --data-binary @$(BUILD_DIR)/$(TARGET).bin \
	  "http://$(OTA_HOST)/firmware?id=$(GIT_ID)&build=$(BUILD_EPOCH)" ; echo

# Firmware del ESP32 por WiFi. Vive aca —y no en el proyecto de IDF— para que
# los dos despliegues se hagan desde el mismo lugar y en el mismo orden.
#
# ⚠️ ORDEN: cuando hay que actualizar los DOS, primero `ota` y despues
# `ota-esp`. El ESP32 es el que transporta la carga hasta el STM32, asi que
# conviene tenerlo estable y conocido hasta el ultimo paso; y ademas el del
# ESP32 es el que se deshace solo si sale mal. La pagina lo dice sola cuando
# detecta que los protocolos no coinciden.
ESP_DIR ?= ../firmware_esp32c3
ESP_BIN  = $(ESP_DIR)/build/ds11_beamform_c3.bin

ota-esp:
	@test -f $(ESP_BIN) || { echo "No existe $(ESP_BIN)."; \
	  echo "Compilalo primero:  cd $(ESP_DIR) && . ~/esp/esp-idf/export.sh && idf.py build"; exit 1; }
	@echo "Subiendo $(ESP_BIN) a http://$(OTA_HOST) ..."
	@curl -sS --max-time 240 -X POST --data-binary @$(ESP_BIN) \
	  "http://$(OTA_HOST)/firmware-esp" ; echo

.PHONY: ota ota-esp boot boot-flash flash-todo

