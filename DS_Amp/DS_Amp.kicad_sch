	(text "DS_Amp - Hat Amplificador 32 Canales\n\nArquitectura:\n- 16x PAM8403 (dual Class-D filterless)\n- Entrada diferencial desde PCM1690 via J9/J10\n- 32 parlantes 0.5-1W / 8 ohm\n- PSU: 5V / 10A externa (separada de DS9)\n\nBancos:\n- Bank A: Ch 1-8   (DAC0, J9 pins 1-16)\n- Bank B: Ch 9-16  (DAC1, J9 pins 17-32)\n- Bank C: Ch 17-24 (DAC2, J10 pins 1-16)\n- Bank D: Ch 25-32 (DAC3, J10 pins 17-32)"
		(exclude_from_sim no)
		(at 176.784 179.578 0)
