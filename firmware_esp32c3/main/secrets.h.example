#ifndef SECRETS_H
#define SECRETS_H

// El instrumento cicla entre redes conocidas (ver WIFI_NETWORKS[] en main.c).
// Agregar mas casas = agregar mas pares _N sin borrar los anteriores, y
// sumarlos al array en main.c.
#define WIFI_SSID    "your-wifi-ssid"
#define WIFI_PASS    "your-wifi-password"

#define WIFI_SSID_2  "your-second-wifi-ssid"
#define WIFI_PASS_2  "your-second-wifi-password"

#endif // SECRETS_H
